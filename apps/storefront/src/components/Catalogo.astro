---
import type { Category, Product } from '../content.config'
import ProductCard from './ProductCard.astro'
import { catalogPagePath, prendasLabel, showingLabel } from '../lib/catalog'
import { categoryChoices, toCatalogItem } from '../lib/filters'

interface Props {
  products: Product[]
  catalog: Product[]
  categories: Category[]
  shown: number
  total: number
  currentPage: number
  lastPage: number
}

const { products, catalog, categories, shown, total, currentPage, lastPage } = Astro.props
const prev = currentPage > 1 ? catalogPagePath(currentPage - 1) : undefined
const next = currentPage < lastPage ? catalogPagePath(currentPage + 1) : undefined

const categoryList = categoryChoices(categories).map((choice) => {
  const source = categories.find((category) => category.slug === choice.slug)
  const image = source?.image
  const imageUrl =
    image?.formats?.thumbnail?.url
    || image?.formats?.small?.url
    || image?.formats?.medium?.url
    || image?.url

  return {
    ...choice,
    imageUrl: imageUrl || null,
    imageAlt: image?.alternativeText?.trim() || choice.name,
  }
})

const datosJson = JSON.stringify({
  items: catalog.map((product) => toCatalogItem(product)),
  categories: categoryList,
}).replace(/</g, '\\u003c')
---

<div
  class="flex flex-col gap-3 pt-3 pb-28"
  data-catalogo
  style="--color-acento: #A3441C; --color-acento-suave: #F8ECE6;"
>
  <form role="search" data-buscar-form>
    <label for="buscar-prendas" class="sr-only">Buscar prendas</label>
    <div class="relative">
      <img
        class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-texto-secundario"
        src="/filtro-v2/buscar.svg"
        alt=""
        width="20"
        height="20"
        aria-hidden="true"
      />
      <input
        id="buscar-prendas"
        name="q"
        type="search"
        placeholder="Buscar prendas"
        autocomplete="off"
        autocapitalize="off"
        data-buscar
        class="h-12 w-full rounded-medio border-0 bg-superficie-hundida pl-10 pr-10 text-texto placeholder:text-texto-secundario"
      />
    </div>
  </form>

  <nav
    data-atajos
    aria-label="Categorías"
    class="flex gap-3 overflow-x-auto"
    hidden={categoryList.length === 0}
  >
    {categoryList.map((category) => (
      <button
        type="button"
        data-atajo={category.slug}
        class="flex w-[72px] shrink-0 cursor-pointer flex-col items-center gap-[6px] text-texto"
        aria-label={`Filtrar por ${category.name}`}
      >
        <span class="flex size-16 items-center justify-center overflow-hidden rounded-pastilla bg-superficie-hundida">
          {category.imageUrl
            ? (
              <img
                src={category.imageUrl}
                alt={category.imageAlt}
                class="h-full w-full object-cover"
                loading="lazy"
                decoding="async"
              />
            )
            : <span class="texto-cuerpo-chico text-texto-secundario">foto</span>}
        </span>
        <span class="max-w-full overflow-hidden text-ellipsis whitespace-nowrap texto-cuerpo-chico">
          {category.name}
        </span>
      </button>
    ))}
  </nav>

  <div data-chips hidden>
    <div data-chips-lista class="flex flex-nowrap items-center gap-2 overflow-x-auto"></div>
  </div>

  <div data-servidor>
    <div class="flex flex-col gap-3">
      <p class="texto-cuerpo-chico text-texto-secundario">{prendasLabel(total)}</p>

      {total > 0 && (
        <ul class="grid list-none grid-cols-2 gap-x-4 gap-y-6 p-0">
          {products.map((product) => (
            <li class="min-w-0">
              <ProductCard product={product} />
            </li>
          ))}
        </ul>
      )}

      {total > 0 && (
        <p class="texto-cuerpo-chico text-center text-texto-secundario">
          {showingLabel(shown, total)}
        </p>
      )}

      {(prev || next) && (
        <nav class="flex items-center justify-center gap-4" aria-label="Paginación">
          {prev && (
            <a href={prev} class="inline-flex min-h-minimo items-center px-3 texto-cuerpo text-texto no-underline">
              Anterior
            </a>
          )}
          {next && (
            <a href={next} class="inline-flex min-h-minimo items-center px-3 texto-cuerpo text-texto no-underline">
              Siguiente
            </a>
          )}
        </nav>
      )}
    </div>
  </div>

  <div data-cliente hidden>
    <div class="flex flex-col gap-3">
      <p data-cuenta class="texto-cuerpo-chico text-texto-secundario" aria-live="polite"></p>
      <div data-grilla-wrap>
        <ul data-grilla class="grid list-none grid-cols-2 gap-x-4 gap-y-6 p-0"></ul>
      </div>
      <p data-mostrando class="texto-cuerpo-chico text-center text-texto-secundario"></p>
      <div data-vacio hidden class="flex flex-col items-center pt-10 text-center" role="status">
        <p data-vacio-titulo class="texto-titulo text-texto"></p>
        <p data-vacio-ayuda class="mt-3 texto-cuerpo text-texto-secundario"></p>
        <button
          type="button"
          data-limpiar-todo
          class="mt-8 inline-flex min-h-cta w-full items-center justify-center rounded-medio bg-acento px-4 texto-etiqueta text-acento-texto"
        >
          Ver todo el catálogo
        </button>
      </div>
    </div>
  </div>

  <div class="pointer-events-none fixed inset-x-0 bottom-0 z-30">
    <div class="contenedor pointer-events-auto pt-3 pb-4">
      <button
        type="button"
        data-abrir
        class="flex min-h-cta w-full items-center justify-center gap-2 rounded-medio bg-acento px-4 texto-etiqueta text-acento-texto shadow-2"
        aria-expanded="false"
        aria-controls="catalogo-dialog"
      >
        <img src="/filtro-v2/filtrar.svg" alt="" width="20" height="20" aria-hidden="true" />
        <span>Filtrar y ordenar</span>
        <span
          data-filtros-cuenta
          class="inline-flex size-6 items-center justify-center rounded-pastilla bg-superficie texto-cuerpo-chico text-acento"
          hidden
          aria-hidden="true"
        ></span>
      </button>
    </div>
  </div>

  <div data-panel hidden class="fixed inset-0 z-40 flex items-end justify-center">
    <button
      type="button"
      data-fondo
      class="absolute inset-0 bg-texto/40"
      aria-label="Cerrar filtros"
      tabindex="-1"
    ></button>
    <div
      id="catalogo-dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="catalogo-panel-titulo"
      class="relative z-10 flex h-[calc(100dvh-40px)] max-h-[804px] w-full max-w-[390px] flex-col overflow-hidden rounded-t-grande bg-superficie shadow-2"
    >
      <div class="shrink-0 border-b border-borde bg-superficie">
        <div class="flex h-4 items-start justify-center pt-2" aria-hidden="true">
          <span class="h-1 w-9 rounded-pastilla bg-borde"></span>
        </div>
        <div class="flex h-14 items-center gap-1 pl-4 pr-1">
          <p id="catalogo-panel-titulo" class="flex-1 texto-subtitulo text-texto">Filtrar y ordenar</p>
          <button
            type="button"
            data-cerrar
            class="inline-flex size-11 shrink-0 items-center justify-center text-texto"
            aria-label="Cerrar"
          >
            <img src="/filtro-v2/cerrar.svg" alt="" width="24" height="24" aria-hidden="true" />
          </button>
        </div>
      </div>
      <div data-opciones class="flex min-h-0 flex-1 flex-col overflow-y-auto px-4"></div>
      <div class="flex shrink-0 gap-3 border-t border-borde bg-superficie px-4 pt-3 pb-4">
        <button
          type="button"
          data-limpiar-panel
          class="inline-flex min-h-cta w-[120px] shrink-0 items-center justify-center rounded-medio border border-acento bg-superficie px-4 texto-etiqueta text-acento"
        >
          Limpiar
        </button>
        <button
          type="button"
          data-aplicar
          class="inline-flex min-h-cta flex-1 items-center justify-center rounded-medio bg-acento px-4 texto-etiqueta text-acento-texto"
        >
          Ver 0 prendas
        </button>
      </div>
    </div>
  </div>

  <template data-tarjetas>
    {catalog.map((product) => (
      <div data-slug={product.slug}>
        <ProductCard product={product} />
      </div>
    ))}
  </template>

  <script id="catalogo-datos" type="application/json" is:inline set:html={datosJson}></script>
  <script>
    import { initCatalogo } from '../scripts/catalogo-ui.ts'
    initCatalogo()
  </script>
</div>
