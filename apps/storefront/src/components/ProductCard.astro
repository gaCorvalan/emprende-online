---
import type { Product } from '../content.config'
import { cardView } from '../lib/catalog'

interface Props {
  product: Product
}

const { product } = Astro.props
const view = cardView(product)

const imageUrl =
  product.image?.formats?.small?.url
  || product.image?.formats?.medium?.url
  || product.image?.formats?.thumbnail?.url
  || product.image?.url

const imageAlt = product.image?.alternativeText?.trim() || product.name
const statusText =
  view.label === 'PIEZA ÚNICA' ? 'Pieza única'
  : view.label === 'ÚLTIMA UNIDAD' ? 'Última unidad'
  : view.label === 'SIN STOCK' ? 'Sin stock'
  : null
const statusTextClass =
  view.label === 'ÚLTIMA UNIDAD' ? 'text-aviso'
  : view.label === 'SIN STOCK' ? 'text-error'
  : 'text-texto'
const statusDotClass =
  view.label === 'ÚLTIMA UNIDAD' ? 'bg-aviso'
  : view.label === 'SIN STOCK' ? 'bg-error'
  : 'bg-texto'
---

<a href={`/productos/${product.slug}`} class="flex h-full flex-col no-underline">
  <div
    class="relative aspect-square overflow-hidden rounded-chico bg-superficie-hundida"
    role={imageUrl ? 'group' : undefined}
    aria-label={imageUrl ? 'Foto 1 de 1' : undefined}
  >
    {imageUrl && (
      <img
        src={imageUrl}
        alt={imageAlt}
        class:list={[
          'h-full w-full object-cover',
          view.label === 'SIN STOCK' && 'opacity-45',
        ]}
        loading="lazy"
        decoding="async"
      />
    )}
  </div>
  <div class="flex w-full flex-col gap-1 overflow-hidden pt-3">
    <p class="h-[40px] w-full overflow-hidden text-ellipsis text-[14px] leading-5 tracking-[-0.084px] line-clamp-2 font-texto text-texto">
      {product.name}
    </p>
    <p
      class:list={[
        'text-[16px] leading-[22px] tracking-[-0.176px] font-texto font-semibold tabular-nums',
        view.priceMuted ? 'text-texto-secundario' : 'text-texto',
      ]}
    >
      {view.priceText}
    </p>
    <div class="flex h-4 w-full items-center overflow-hidden">
      {statusText && (
        <p class:list={['inline-flex items-center gap-[6px] text-[12px] leading-4 font-texto font-medium', statusTextClass]}>
          <span class:list={['size-[6px] shrink-0 rounded-full', statusDotClass]} aria-hidden="true"></span>
          {statusText}
        </p>
      )}
    </div>
  </div>
</a>
